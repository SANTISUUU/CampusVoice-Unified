# Copy the full URL from Supabase Dashboard -> Connect -> Transaction pooler.
# Do not guess the pooler host. URL-encode reserved password characters.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:6543/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only Supabase secret key. Never expose it in browser JavaScript.
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-secret-key
# Legacy fallback supported by app.py; prefer SUPABASE_SECRET_KEY for new setup.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-legacy-service-role-key

# Set a long random value before deployment. Never commit your real key.
SECRET_KEY=replace-with-a-long-random-secret
